<UserControl x:Class="ContractSystem.Windows.Views.Configuracion.BusinessInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ContractSystem.Windows.ViewModels"
             xmlns:controls="clr-namespace:ContractSystem.Windows.Shared.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" Margin="0,0,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nombre del Negocio" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Padding="4"/>

                <TextBlock Text="NIT" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Nit, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Padding="4"/>

                <TextBlock Text="Dirección" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Padding="4"/>

                <TextBlock Text="Teléfono" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Padding="4"/>

                <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Padding="4"/>
                
                <TextBlock Text="Eslogan" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Eslogan, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Padding="4"/>
                
                <TextBlock Text="Nombre del Dueño" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox Text="{Binding NombreDueno, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" Padding="4"/>

                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,8,0,0">
                    <controls:DatosLegalesEditor DataContext="{Binding DatosLegales}"/>
                </Border>

                <!-- Textos de los bloques que inserta el panel "Llenar en Word" -->
                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Textos para contratos" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextInactive}" Margin="0,0,0,4"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource BrushTextInactive}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Son los bloques que se insertan desde «Llenar en Word». Los marcadores entre llaves se sustituyen por los datos de cada parte; si falta un dato se deja una línea ________ para completarla a mano."/>

                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Restaurar predeterminado" Padding="8,2" FontSize="11"
                                    Command="{Binding RestaurarComparecenciaCommand}"/>
                            <TextBlock Text="Bloque de comparecencia" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding PlantillaComparecencia, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxLength="4000"
                                 VerticalScrollBarVisibility="Auto" Padding="4" Margin="0,0,0,12"/>

                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Content="Restaurar predeterminado" Padding="8,2" FontSize="11"
                                    Command="{Binding RestaurarFirmaCommand}"/>
                            <TextBlock Text="Bloque de firma" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding PlantillaFirma, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" MaxLength="2000"
                                 VerticalScrollBarVisibility="Auto" Padding="4" Margin="0,0,0,8"/>

                        <TextBlock Text="Marcadores disponibles:" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextInactive}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding AyudaMarcadores}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushTextInactive}" Margin="0,0,0,16"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Logo" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" 
                    Background="White" HorizontalAlignment="Left" Margin="0,0,0,12">
                <Image Source="{Binding Logo, Converter={StaticResource ByteArrayToImageSource}}" 
                       Height="150" Width="150" Stretch="Uniform" Margin="4"/>
            </Border>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Button Content="Subir Logo" Command="{Binding UploadLogoCommand}" Margin="0,0,8,0" Padding="12,6"/>
                <Button Content="Eliminar" Command="{Binding RemoveLogoCommand}" Padding="12,6"/>
            </StackPanel>

            <Button Content="Guardar Cambios" Command="{Binding SaveCommand}" 
                    HorizontalAlignment="Left" Padding="24,8" 
                    Background="{StaticResource BrushAccent}" Foreground="White"
                    FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</UserControl>
