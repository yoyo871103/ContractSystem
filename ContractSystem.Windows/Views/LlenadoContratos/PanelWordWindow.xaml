<Window x:Class="ContractSystem.Windows.Views.LlenadoContratos.PanelWordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ContractSystem.Windows.ViewModels.LlenadoContratos"
        xmlns:controls="clr-namespace:ContractSystem.Windows.Shared.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PanelWordViewModel}"
        Title="Llenar contrato en Word"
        Width="390" Height="760" MinWidth="320" MinHeight="400"
        Topmost="True" ShowInTaskbar="True"
        WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BrushBackground}">
    <Window.Resources>
        <!-- Fila de dato insertable: un botón plano con la etiqueta y el valor -->
        <Style x:Key="BotonCampo" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fondo" Background="White" CornerRadius="4" Padding="8,5"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="{StaticResource BrushHover}"/>
                                <Setter TargetName="Fondo" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fondo" Property="Background" Value="#F7F7F7"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonBloque" TargetType="Button">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextInactive}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- Contenido de cada pestaña (Mis datos / Otra parte) -->
        <DataTemplate x:Key="PlantillaParte" DataType="{x:Type vm:ParteViewModel}">
            <Grid>
                <TextBlock Text="Elija la otra parte arriba para ver sus datos."
                           Foreground="{StaticResource BrushTextInactive}" TextWrapping="Wrap" Margin="4,12"
                           x:Name="SinFicha"/>
                <DockPanel x:Name="ConFicha">
                    <!-- Bloques completos -->
                    <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,8">
                        <Button Content="Comparecencia" Style="{StaticResource BotonBloque}" Margin="0,0,4,0"
                                Command="{Binding InsertarComparecenciaCommand}"
                                ToolTip="Inserta el párrafo completo: nombre, domicilio, REEUP, NIT, cuenta, representante…"/>
                        <Button Content="Bloque de firma" Style="{StaticResource BotonBloque}" Margin="4,0,0,0"
                                Command="{Binding InsertarFirmaCommand}"
                                ToolTip="Inserta la denominación, la línea de firma, el representante, su cargo y la entidad"/>
                    </UniformGrid>

                    <!-- Representante y cuenta a usar -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Representante" Style="{StaticResource Etiqueta}"/>
                            <ComboBox ItemsSource="{Binding Representantes}" SelectedItem="{Binding Representante}"
                                      DisplayMemberPath="Nombre" Padding="6,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cuenta" Style="{StaticResource Etiqueta}"/>
                            <ComboBox ItemsSource="{Binding Cuentas}" SelectedItem="{Binding Cuenta}" Padding="6,4">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Moneda, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Numero, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Datos sueltos, agrupados -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CamposVista}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextInactive}" Margin="2,8,0,4"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource BotonCampo}"
                                            IsEnabled="{Binding TieneValor}"
                                            Command="{Binding DataContext.InsertarCampoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Clic para insertar en Word, donde está el cursor">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Etiqueta}" FontSize="10" Foreground="{StaticResource BrushTextInactive}"/>
                                            <TextBlock x:Name="Valor" Text="{Binding Valor}" FontSize="13" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding TieneValor}" Value="False">
                                            <Setter TargetName="Valor" Property="Text" Value="(sin dato: complételo en Configuración)"/>
                                            <Setter TargetName="Valor" Property="Foreground" Value="{StaticResource BrushTextInactive}"/>
                                            <Setter TargetName="Valor" Property="FontStyle" Value="Italic"/>
                                            <Setter TargetName="Valor" Property="FontSize" Value="11"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding TieneFicha}" Value="False">
                    <Setter TargetName="ConFicha" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SinFicha" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding TieneFicha}" Value="True">
                    <Setter TargetName="SinFicha" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Cabecera: documento y contexto -->
        <StackPanel DockPanel.Dock="Top">
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Padding="8,5" Margin="6,0,0,0" Cursor="Hand"
                        Command="{Binding RecargarCommand}"
                        ToolTip="Volver a leer los datos (si los cambió en Configuración)">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"/>
                </Button>
                <Button DockPanel.Dock="Right" Content="Abrir proforma…" Padding="10,5" Cursor="Hand"
                        Command="{Binding AbrirDocumentoCommand}"
                        ToolTip="Abre un documento de Word para llenarlo"/>
                <TextBlock Text="{Binding ContratoDescripcion}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextActive}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <TextBlock Text="En este contrato actúo como" Style="{StaticResource Etiqueta}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Content="Proveedor" IsChecked="{Binding SoyProveedor}" Margin="0,0,16,0" GroupName="Papel"/>
                <RadioButton Content="Cliente" IsChecked="{Binding SoyCliente}" GroupName="Papel"/>
            </StackPanel>

            <TextBlock Text="Otra parte" Style="{StaticResource Etiqueta}"/>
            <controls:AutoCompleteSelector Margin="0,0,0,10"
                                           ItemsSource="{Binding Terceros}"
                                           SelectedItem="{Binding TerceroSeleccionado}"
                                           DisplayMemberPath="Nombre"
                                           SearchMemberPaths="Codigo,NifCif,RazonSocial"
                                           Placeholder="Buscar por nombre, código o NIT…"
                                           ShowAddButton="False"/>

            <!-- Acción principal: llenar todo de una vez -->
            <Button Command="{Binding AutollenarCommand}" Style="{StaticResource BotonBloque}" Padding="10,9" Margin="0,0,0,4"
                    ToolTip="Busca en el documento abierto en Word los espacios a llenar (NIT, domicilio, representante, cuenta…) y los rellena con sus datos y los de la otra parte, tras su revisión">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Autollenar la proforma"/>
                </StackPanel>
            </Button>
            <Button Content="Quitar resaltado amarillo" Padding="8,4" Margin="0,0,0,4" Cursor="Hand" FontSize="11"
                    Command="{Binding QuitarResaltadoCommand}"
                    ToolTip="Quita el resaltado de lo escrito por el autollenado (no toca otros resaltados del documento)">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HayResaltado}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Text="…o coloque el cursor en Word y use los datos de abajo." FontSize="11" Margin="0,0,0,10"
                       Foreground="{StaticResource BrushTextInactive}"/>

            <TextBlock Text="Tipo de contrato (denominación de las partes)" Style="{StaticResource Etiqueta}"/>
            <ComboBox ItemsSource="{Binding ParesDenominaciones}" SelectedItem="{Binding ParDenominaciones}"
                      Padding="6,4" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Yo me denomino" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding DenominacionMia, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="La otra parte" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding DenominacionOtra, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Moneda" Style="{StaticResource Etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Monedas}" SelectedItem="{Binding Moneda}" Padding="6,3"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Pie: estado de la última acción -->
        <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="4" Padding="8,6" Margin="0,8,0,0"
                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <TextBlock Text="{Binding Estado}" TextWrapping="Wrap" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextInactive}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EstadoEsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Pie: guardar el documento llenado en el contrato -->
        <Button DockPanel.Dock="Bottom" Padding="10,7" Margin="0,8,0,0" Cursor="Hand"
                Command="{Binding GuardarEnContratoCommand}"
                ToolTip="Guarda el documento de Word en los adjuntos del contrato (actualiza el adjunto si lo abrió desde el contrato)">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Guardar en el contrato" FontWeight="SemiBold"/>
            </StackPanel>
        </Button>

        <!-- Datos de cada parte -->
        <TabControl Background="Transparent">
            <TabItem Header="Mis datos" Content="{Binding Mia}" ContentTemplate="{StaticResource PlantillaParte}"/>
            <TabItem Header="Otra parte" Content="{Binding Otra}" ContentTemplate="{StaticResource PlantillaParte}"/>
        </TabControl>
    </DockPanel>
</Window>
