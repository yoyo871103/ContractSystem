<Window x:Class="ContractSystem.Windows.Views.LlenadoContratos.RevisionAutollenadoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ContractSystem.Windows.ViewModels.LlenadoContratos"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RevisionAutollenadoViewModel}"
        Title="{Binding Titulo}"
        Width="980" Height="620" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{StaticResource BrushBackground}">
    <DockPanel Margin="16">
        <!-- Encabezado -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Resumen}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock FontSize="11" Foreground="{StaticResource BrushTextInactive}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Revise antes de llenar: puede desmarcar filas, cambiar de qué parte es cada dato o corregir el valor. Lo escrito quedará resaltado en amarillo en Word y se puede deshacer de una vez con Ctrl+Z."/>
        </StackPanel>

        <!-- Pie -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Intercambiar partes" Padding="12,6" Cursor="Hand"
                    Command="{Binding IntercambiarPartesCommand}"
                    ToolTip="Úselo si se detectó al revés cuáles son sus datos y cuáles los de la otra parte"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Padding="16,8" Margin="0,0,8,0" IsCancel="True" Cursor="Hand"/>
                <Button Content="{Binding TextoAceptar}" Padding="16,8" IsDefault="True" Cursor="Hand"
                        IsEnabled="{Binding HayMarcados}"
                        Background="{StaticResource BrushAccent}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        Click="BtnLlenar_Click"/>
            </StackPanel>
        </DockPanel>

        <DataGrid ItemsSource="{Binding Filas}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single"
                  BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Background="White"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Aplicar, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding TieneValor}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Parte" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.Opciones, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      SelectedItem="{Binding Parte, UpdateSourceTrigger=PropertyChanged}"
                                      Padding="4,2" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Dato" Binding="{Binding Dato}" Width="170" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Dónde (en el documento)" Binding="{Binding Contexto}" Width="2*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextInactive}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Se escribirá" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <TextBox Text="{Binding Valor, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"
                                         TextWrapping="Wrap" BorderThickness="0,0,0,1"/>
                                <TextBlock Text="(sin dato guardado: escríbalo aquí o complételo en Configuración)"
                                           FontSize="11" FontStyle="Italic" Foreground="{StaticResource BrushTextInactive}"
                                           IsHitTestVisible="False" Margin="6,3" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TieneValor}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
