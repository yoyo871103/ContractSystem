<Window x:Class="ContractSystem.Windows.Views.Contratos.HistorialCambioDetalleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle del cambio"
        Height="500" Width="650"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="12,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Detalle del cambio" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextActive}"/>
                    <Button Grid.Column="1" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Cerrar" Click="BtnCerrar_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource BrushTextInactive}"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fecha:" FontWeight="SemiBold" FontSize="12" Margin="0,2,12,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtFecha" FontSize="12" Margin="0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Tipo:" FontWeight="SemiBold" FontSize="12" Margin="16,2,12,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtTipo" FontSize="12" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Usuario:" FontWeight="SemiBold" FontSize="12" Margin="0,2,12,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="TxtUsuario" FontSize="12" Margin="0,2"/>
                    </Grid>

                    <TextBlock Text="Descripción" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4"/>
                    <Border Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtDescripcion" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Valor anterior" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4"/>
                    <Border Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="0,0,0,16">
                        <TextBox x:Name="TxtValorAnterior" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontFamily="Consolas" FontSize="11"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" MaxHeight="120"/>
                    </Border>

                    <TextBlock Text="Valor nuevo" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource BrushAccent}" Margin="0,0,0,4"/>
                    <Border Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            CornerRadius="4" Padding="10" Margin="0,0,0,16">
                        <TextBox x:Name="TxtValorNuevo" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontFamily="Consolas" FontSize="11"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" MaxHeight="120"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                    Padding="12,10">
                <Button Content="Cerrar" Padding="16,8" Cursor="Hand" HorizontalAlignment="Right"
                        Click="BtnCerrar_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
