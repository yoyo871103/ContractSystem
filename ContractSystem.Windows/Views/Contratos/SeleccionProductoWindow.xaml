<Window x:Class="ContractSystem.Windows.Views.Contratos.SeleccionProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Producto/Servicio"
        Height="520" Width="680"
        MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}">
    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="12,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Seleccionar del catálogo de productos y servicios"
                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrushTextActive}"/>
            </Border>

            <!-- Búsqueda + alta rápida -->
            <Grid Grid.Row="1" Margin="12,12,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="32" Background="White"
                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="{StaticResource BrushTextInactive}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtBuscar" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" FontSize="13"
                                 TextChanged="TxtBuscar_TextChanged" PreviewKeyDown="TxtBuscar_PreviewKeyDown"
                                 ToolTip="Buscar por nombre, código o descripción"/>
                        <TextBlock Grid.Column="1" x:Name="TxtBuscarPlaceholder" IsHitTestVisible="False"
                                   Text="Buscar por nombre, código o descripción..." Foreground="#9A9A9A"
                                   VerticalAlignment="Center" Margin="2,0,0,0" FontSize="13"/>
                    </Grid>
                </Border>
                <Button Grid.Column="1" x:Name="BtnNuevo" Margin="8,0,0,0" Padding="12,0"
                        Background="{StaticResource BrushAccent}" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnNuevo_Click"
                        ToolTip="Dar de alta un producto/servicio en el catálogo y seleccionarlo">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuevo producto/servicio" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2" Margin="12">
                <DataGrid x:Name="DgProductos"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                          MouseDoubleClick="DgProductos_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="70"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="U.M." Binding="{Binding UnidadMedida.NombreCorto}" Width="60"/>
                        <DataGridTextColumn Header="Precio Est." Binding="{Binding PrecioEstimado, StringFormat=N2}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="TxtVacio" IsHitTestVisible="False" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="20" Foreground="{StaticResource BrushTextInactive}"/>
            </Grid>

            <Border Grid.Row="3" Background="White"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                    Padding="12,10">
                <Grid>
                    <TextBlock x:Name="TxtContador" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource BrushTextInactive}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Padding="16,8" Cursor="Hand" Click="BtnCancelar_Click"/>
                        <Button Content="Seleccionar" Padding="16,8" Margin="8,0,0,0" Cursor="Hand"
                                Background="{StaticResource BrushAccent}" Foreground="White" BorderThickness="0"
                                Click="BtnSeleccionar_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
