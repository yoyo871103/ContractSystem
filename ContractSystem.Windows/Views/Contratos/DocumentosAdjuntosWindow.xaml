<Window x:Class="ContractSystem.Windows.Views.Contratos.DocumentosAdjuntosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ContractSystem.Windows.Views.Contratos"
        Title="Documentos Adjuntos"
        Height="580" Width="980"
        MinHeight="420" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}">
    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="12,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TxtTitulo" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextActive}"/>
                        <TextBlock x:Name="TxtSubtitulo" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{StaticResource BrushTextInactive}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Cerrar" Click="BtnCerrar_Click" VerticalAlignment="Top">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource BrushTextInactive}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Cuerpo -->
            <local:AdjuntosPanel x:Name="Panel" Grid.Row="1" Margin="12"/>

            <!-- Pie fijo -->
            <Border Grid.Row="2" Background="White"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                    Padding="12,10">
                <Grid>
                    <TextBlock x:Name="TxtResumen" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource BrushTextInactive}"/>
                    <Button Content="Cerrar" Padding="16,8" Cursor="Hand" HorizontalAlignment="Right"
                            Click="BtnCerrar_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
