<UserControl x:Class="ContractSystem.Windows.Views.Contratos.AdjuntosPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado opcional -->
        <TextBlock x:Name="TxtTitulo" Grid.Row="0" FontWeight="SemiBold" FontSize="12"
                   Foreground="{StaticResource BrushTextActive}" Margin="0,0,0,6"
                   Visibility="Collapsed"/>

        <!-- Barra de acciones -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnAdjuntar" Padding="10,5" Cursor="Hand" Click="BtnAdjuntar_Click"
                        Background="{StaticResource BrushAccent}" Foreground="White" BorderThickness="0"
                        ToolTip="Adjuntar archivo(s). También puede arrastrarlos sobre la lista.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Adjuntar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnVer" Padding="10,5" Margin="6,0,0,0" Cursor="Hand" Click="BtnVer_Click"
                        ToolTip="Ver el adjunto sin descargarlo (también con doble clic)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Ver" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnDescargar" Padding="10,5" Margin="6,0,0,0" Cursor="Hand" Click="BtnDescargar_Click"
                        ToolTip="Descargar / guardar una copia del adjunto">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Descargar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnEliminar" Padding="10,5" Margin="6,0,0,0" Cursor="Hand" Click="BtnEliminar_Click"
                        ToolTip="Eliminar el adjunto seleccionado">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Eliminar" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="PnlFiltro" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="Mostrar:" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource BrushTextInactive}" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbFiltro" Width="190" Padding="6,4" FontSize="12"
                          SelectionChanged="CmbFiltro_SelectionChanged"/>
            </StackPanel>
        </Grid>

        <!-- Lista -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="DgAdjuntos"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                      AllowDrop="True" Drop="DgAdjuntos_Drop" DragOver="DgAdjuntos_DragOver"
                      MouseDoubleClick="DgAdjuntos_MouseDoubleClick"
                      SelectionChanged="DgAdjuntos_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Ver" Click="BtnVer_Click"/>
                        <MenuItem Header="Descargar..." Click="BtnDescargar_Click"/>
                        <MenuItem x:Name="MnuEliminar" Header="Eliminar" Click="BtnEliminar_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="28" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Icono}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{StaticResource BrushAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColTipo" Header="Tipo" Binding="{Binding TipoAsociacion}" Width="85"/>
                    <DataGridTextColumn x:Name="ColAsociado" Header="Asociado a" Binding="{Binding AsociadoA}" Width="190"/>
                    <DataGridTextColumn Header="Nombre" Binding="{Binding NombreArchivo}" Width="*"/>
                    <DataGridTextColumn Header="Objetivo" Binding="{Binding Objetivo}" Width="*"/>
                    <DataGridTextColumn Header="Tamaño" Binding="{Binding TamanioTexto}" Width="75"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding FechaCarga, StringFormat=dd/MM/yyyy HH:mm}" Width="115"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="TxtVacio" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,30,12,0"
                       TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                       Foreground="{StaticResource BrushTextInactive}" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
