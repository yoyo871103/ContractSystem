<Window x:Class="ContractSystem.Windows.Views.Contratos.AdjuntarArchivoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjuntar archivo"
        Height="430" Width="520"
        MinHeight="380" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Adjuntar archivo" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextActive}"/>
                    <Button Grid.Column="1" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Cerrar" Click="BtnCancelar_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource BrushTextInactive}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Cuerpo -->
            <StackPanel Grid.Row="1" Margin="20,16">
                <TextBlock Text="Asociar a *" FontSize="11" Foreground="{StaticResource BrushTextInactive}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbDestino" FontSize="14" Padding="10,8" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtDestinoFijo" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,4"
                           Visibility="Collapsed"/>
                <TextBlock Text="El adjunto quedará vinculado a ese documento (contrato, suplemento, factura o anexo)."
                           FontSize="11" Foreground="{StaticResource BrushTextInactive}" TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Archivo(s) *" FontSize="11" Foreground="{StaticResource BrushTextInactive}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Seleccionar..." Padding="10,6"
                            Background="{StaticResource BrushAccent}" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="BtnSeleccionar_Click"/>
                    <TextBlock Grid.Column="1" x:Name="TxtArchivos" Text="Ningún archivo seleccionado"
                               FontSize="12" Foreground="{StaticResource BrushTextInactive}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
                <TextBlock x:Name="TxtTiposPermitidos" FontSize="11" Foreground="{StaticResource BrushTextInactive}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Objetivo / descripción *" FontSize="11" Foreground="{StaticResource BrushTextInactive}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtObjetivo" FontSize="14" Padding="10,8" TextWrapping="Wrap"
                         AcceptsReturn="True" MinHeight="54" MaxHeight="100" VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <!-- Pie -->
            <Border Grid.Row="2" Background="White"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Padding="16,8" Cursor="Hand" Click="BtnCancelar_Click"/>
                    <Button Content="Adjuntar" Padding="16,8" Margin="8,0,0,0" Cursor="Hand"
                            Background="{StaticResource BrushAccent}" Foreground="White" BorderThickness="0"
                            Click="BtnAceptar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
