<Window x:Class="ContractSystem.Windows.Views.Contratos.VisorAdjuntoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:controls="clr-namespace:ContractSystem.Windows.Shared.Controls"
        Title="Visor de adjunto"
        Height="700" Width="900"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BrushBackground}"
        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="12,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtTitulo" Grid.Column="0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextActive}" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Cerrar" Click="BtnCerrar_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource BrushTextInactive}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Cuerpo: WebView2 (PDF/imágenes), vista previa de Office, texto plano
                 o panel "abrir en app externa" -->
            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="WebView" Visibility="Collapsed"/>

                <controls:PreviewHandlerHost x:Name="PreviewHost" Visibility="Collapsed"/>

                <TextBox x:Name="TxtContenido" Visibility="Collapsed" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="13" Padding="12" BorderThickness="0"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

                <!-- Panel para Office / no soportado -->
                <StackPanel x:Name="PanelExterno" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="500">
                    <TextBlock x:Name="TxtMensajeExterno"
                               TextWrapping="Wrap" TextAlignment="Center" FontSize="14"
                               Foreground="{StaticResource BrushTextInactive}" Margin="0,0,0,16"/>
                    <Button x:Name="BtnAbrirExterno" Content="Abrir con la aplicación predeterminada"
                            Padding="16,8"
                            Background="{StaticResource BrushAccent}" Foreground="White" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Center"
                            Click="BtnAbrirExterno_Click"/>
                </StackPanel>

                <!-- Indicador de carga -->
                <TextBlock x:Name="TxtCargando" Text="Cargando..."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="{StaticResource BrushTextInactive}"/>
            </Grid>

            <!-- Pie -->
            <Border Grid.Row="2" Background="White"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                    Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Guardar como..." Padding="12,6"
                                Cursor="Hand" Click="BtnGuardarComo_Click"/>
                        <Button x:Name="BtnAbrirExternoPie" Content="Abrir en aplicación externa" Padding="12,6"
                                Margin="8,0,0,0" Cursor="Hand" Click="BtnAbrirExterno_Click"
                                ToolTip="Abrir una copia temporal con la aplicación predeterminada (Word, Excel...)"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Cerrar" Padding="16,8" Cursor="Hand"
                            Click="BtnCerrar_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
