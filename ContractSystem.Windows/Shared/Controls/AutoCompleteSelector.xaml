<UserControl x:Class="ContractSystem.Windows.Shared.Controls.AutoCompleteSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Caja de búsqueda -->
        <Border x:Name="BrdTexto" Grid.Column="0" Background="White"
                BorderBrush="#ABADB3" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{StaticResource BrushTextInactive}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtBuscar" Grid.Column="1" BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center" Padding="0,8,4,8"
                         FontSize="{Binding FontSize, ElementName=Root}"
                         TextChanged="TxtBuscar_TextChanged"
                         PreviewKeyDown="TxtBuscar_PreviewKeyDown"
                         GotKeyboardFocus="TxtBuscar_GotKeyboardFocus"
                         PreviewMouseLeftButtonDown="TxtBuscar_PreviewMouseLeftButtonDown"
                         LostKeyboardFocus="TxtBuscar_LostKeyboardFocus"/>
                <TextBlock x:Name="TxtPlaceholder" Grid.Column="1" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="2,0,0,0"
                           FontSize="{Binding FontSize, ElementName=Root}"
                           Foreground="#9A9A9A"/>
                <Button x:Name="BtnLimpiar" Grid.Column="2" Width="26" Padding="0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="Quitar selección" Visibility="Collapsed" Focusable="False"
                        Click="BtnLimpiar_Click">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                               Foreground="{StaticResource BrushTextInactive}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Botón agregar nuevo -->
        <Button x:Name="BtnAgregar" Grid.Column="1" Margin="6,0,0,0" Padding="10,0"
                Background="{StaticResource BrushAccent}" Foreground="White" BorderThickness="0"
                Cursor="Hand" Click="BtnAgregar_Click" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtAgregar" Text="Nuevo" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <!-- Lista de sugerencias -->
        <Popup x:Name="PopSugerencias" Grid.Column="0" PlacementTarget="{Binding ElementName=BrdTexto}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               Width="{Binding ActualWidth, ElementName=BrdTexto}">
            <Border Background="White" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                    Margin="0,2,0,0">
                <Grid>
                    <ListBox x:Name="LstSugerencias" MaxHeight="260" BorderThickness="0"
                             FontSize="{Binding FontSize, ElementName=Root}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="LstSugerencias_PreviewMouseLeftButtonUp"/>
                    <TextBlock x:Name="TxtSinResultados" Margin="10,8" Visibility="Collapsed"
                               Foreground="{StaticResource BrushTextInactive}" FontStyle="Italic"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
